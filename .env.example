# Copy to .env.local for local dev, and add the same values in Vercel → Project → Settings → Environment Variables.

# Public Web3Forms access key (safe to expose; sends form submissions to your email)
NEXT_PUBLIC_WEB3FORMS_KEY=

# Telegram bot — SERVER ONLY, never prefix these with NEXT_PUBLIC_
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
